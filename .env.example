# Application
NODE_ENV=development
PORT=3000
APP_NAME=Mandarina Auth

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/mandarina_db

# JWT
JWT_ACCESS_SECRET=your-super-secret-access-key-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRES_IN=30d

# OTP
OTP_EXPIRES_IN_MINUTES=10
OTP_MAX_ATTEMPTS=3
# Seconds the user must wait before requesting a new OTP code
OTP_RESEND_COOLDOWN_SECONDS=60

# Session
SESSION_EXPIRES_IN_DAYS=30

# Email (Resend — https://resend.com)
EMAIL_FROM=noreply@mandarina.app
RESEND_API_KEY=re_your_api_key_here

# Throttler (rate limiting)
THROTTLE_TTL=60
THROTTLE_LIMIT=10
THROTTLE_AUTH_LIMIT=5

# Google OAuth (Sign-In with Google — https://console.cloud.google.com)
# Create an OAuth 2.0 Client ID (Web application) and add the callback URL below
# as an authorized redirect URI.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
# Base URL of the PWA; the Google callback redirects here with ?status= or ?error=
FRONTEND_URL=http://localhost:5173
